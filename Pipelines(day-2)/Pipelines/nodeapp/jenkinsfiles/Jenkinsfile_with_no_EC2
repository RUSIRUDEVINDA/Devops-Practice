pipeline {
    agent any
    
    stages { 
        stage('SCM Checkout') {
            steps {
                retry(3) {
                    git branch: 'main', url: 'https://github.com/RUSIRUDEVINDA/Devops-Practice.git'
                }
            }
        }
        stage('Build Docker Image') {
            steps {  
                bat 'docker build -t rusiru49devinda/build-1-10:%BUILD_NUMBER% .'
            }
        }
        stage('Login to Docker Hub') {
            steps {
                withCredentials([string(credentialsId: 'rusiru-dockerhub-pass', variable: 'rusiru-dockerhub-pw')]) {
                    script {
                        bat "docker login -u rusiru49devinda -p %rusiru-dockerhub-pw%"
                    }
                }
            }
        }
        stage('Push Image') {
            steps {
                bat 'docker push rusiru49devinda/build-1-10:%BUILD_NUMBER%'
            }
        }
    }
    post {
        always {
            bat 'docker logout'
        }
    }
}
